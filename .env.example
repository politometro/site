# Politómetro - Environment Variables (example, copy to .env and fill in)
# .env is gitignored; never commit real secrets.

# Configuração do Pinecone
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX_NAME=politometro

# Opcional: modelo de embedding local (predefinição abaixo)
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Turso (libSQL) - armazenamento do texto integral dos chunks (mantém o Pinecone dentro do limite de 2 GB do escalão free)
# Crie uma base de dados gratuita em https://turso.tech e depois: turso db tokens create <nome-da-base>
TURSO_URL=https://<db-name>-<org>.turso.io
TURSO_TOKEN=
